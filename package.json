{
  "name": "remotion-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Drop in a Remotion code file, preview it instantly and render a broadcast-quality video. Free browser rendering + optional max-power server rendering. Deploys to Vercel.",
	"license": "MIT",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"predev": "node scripts/sync-samples.mjs",
		"dev": "next dev --webpack",
		"prebuild": "node scripts/sync-samples.mjs",
		"build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/sync-samples.mjs",
    "assets:visual": "node scripts/generate-visual-assets.mjs",
    "assets:audio": "node scripts/generate-audio-assets.mjs",
    "assets:library": "node scripts/build-asset-library.mjs",
    "assets": "npm run assets:visual && npm run assets:audio && npm run assets:library",
    "assets:verify": "node scripts/generate-audio-assets.mjs --verify-only",
    "studio": "remotion studio samples/code-becomes-geometry.tsx",
    "studio:neon": "remotion studio samples/neon-product-reveal.tsx",
    "render:local": "node scripts/render-local.mjs",
    "render:sample": "node scripts/render-local.mjs samples/code-becomes-geometry.tsx --preset max"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.508",
    "@remotion/gif": "4.0.508",
    "@remotion/media": "4.0.508",
    "@remotion/media-utils": "4.0.508",
    "@remotion/motion-blur": "4.0.508",
    "@remotion/noise": "4.0.508",
    "@remotion/paths": "4.0.508",
    "@remotion/player": "4.0.508",
    "@remotion/renderer": "4.0.508",
    "@remotion/shapes": "4.0.508",
    "@remotion/transitions": "4.0.508",
    "@remotion/web-renderer": "4.0.508",
    "@vercel/blob": "^2.8.0",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.508",
    "sucrase": "^3.35.0",
    "webm-muxer": "^5.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.508",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
