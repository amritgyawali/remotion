{
	"$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Editor Studio",
	"version": "0.1.0",
	"identifier": "com.remotionvideostudio.editorstudio",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5183",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Editor Studio",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 600,
				"resizable": true,
				"maximizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"android": {
			"minSdkVersion": 24
		}
	}
}
