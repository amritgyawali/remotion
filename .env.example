# ---------------------------------------------------------------------------
# Remotion Video Studio - environment variables
# Everything below is OPTIONAL for device-local browser rendering. With no .env
# file the app still works through WebCodecs; Remotion and hosting license terms
# still apply to the project using it.
# ---------------------------------------------------------------------------

# Turn the server-side renderer (/api/render) on.
# Server rendering executes the uploaded code inside a headless Chrome on YOUR
# server, so only enable it for trusted users or behind auth.
# Values: "1" to enable, anything else / unset = disabled.
ENABLE_SERVER_RENDER=0

# Shared secret sent as x-render-key. Required for every Node or Vercel server
# renderer. The local CLI does not need this key.
RENDER_ACCESS_KEY=

# Server-only NVIDIA NIM key used by the Chat -> Remotion generator. Generate
# the actual secret on build.nvidia.com; NVIDIA keys normally begin with nvapi-.
# Never prefix this variable with NEXT_PUBLIC_.
NVIDIA_API_KEY=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

# Subtitle Studio speech recognition (optional).
# Automatic captions call NVIDIA's hosted speech models with the same
# NVIDIA_API_KEY above, so nothing extra is required for the default setup.
# Those models are NVIDIA Cloud Functions reached over gRPC at
# grpc.nvcf.nvidia.com:443; the studio ships the function id of every model it
# offers. Override these only to point somewhere else - a self-hosted Riva NIM,
# or a private NVCF deployment:
#   NVIDIA_ASR_GRPC          - host:port of a Riva ASR service
#                              (self-hosted default: localhost:50051)
#   NVIDIA_ASR_GRPC_INSECURE - "1" for a plaintext Riva server, "0" to force TLS.
#                              Unset means TLS everywhere except loopback.
#   NVIDIA_ASR_DISABLE_GRPC  - "1" to skip gRPC entirely and use HTTP only
#   NVIDIA_ASR_ENDPOINT      - full URL of an HTTP /v1/audio/transcriptions
#                              endpoint, e.g. http://localhost:9000/v1/audio/transcriptions
#   NVIDIA_ASR_FUNCTION_ID   - pin one NVCF function id instead of the one that
#                              belongs to the selected model
#   NVIDIA_ASR_MODEL         - pin one model instead of choosing by spoken
#                              language (openai/whisper-large-v3 covers every
#                              language the studio offers, including Nepali)
#
# Vocabulary hints. Riva raises the probability of these phrases against
# similar-sounding words, which is the one lever that fixes a name, product or
# place written differently from the way it was spoken:
#   NVIDIA_ASR_PHRASES       - comma-separated phrases the speech is likely to
#                              contain, e.g. "Remotion,Mediabunny,Kathmandu"
#   NVIDIA_ASR_PHRASE_BOOST  - how hard to push them; NVIDIA recommends 0 - 20,
#                              default 6. Higher recall costs false positives.
NVIDIA_ASR_GRPC=
NVIDIA_ASR_GRPC_INSECURE=
NVIDIA_ASR_DISABLE_GRPC=
NVIDIA_ASR_ENDPOINT=
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_ASR_MODEL=
NVIDIA_ASR_PHRASES=
NVIDIA_ASR_PHRASE_BOOST=

# Hard safety caps for Node and Vercel Sandbox renders.
MAX_RENDER_FRAMES=1800
MAX_RENDER_PIXELS=8294400

# Chromium OpenGL backend used by the Node renderer. ANGLE is required for
# ThreeCanvas and has a software fallback when no physical GPU is available.
REMOTION_GL=angle

# Concurrency for Node/Vercel rendering. "auto" lets Remotion choose a
# memory-safe worker count; set a number only after measuring the host.
REMOTION_CONCURRENCY=auto

# Browser-render licensing. The default app value is "free-license", suitable
# only when you qualify under https://remotion.dev/license. Otherwise replace
# it with the license key purchased from Remotion.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=free-license

# Required for Vercel Sandbox rendering. Connect a Blob store in the Vercel
# dashboard; Vercel injects this token. It stays optional on a normal Node host.
BLOB_READ_WRITE_TOKEN=

# Optional Vercel Sandbox sizing. Check the limits and cost for your plan.
VERCEL_SANDBOX_VCPUS=4
VERCEL_SANDBOX_TIMEOUT_MS=2700000
