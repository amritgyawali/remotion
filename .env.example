# ---------------------------------------------------------------------------
# Remotion Video Studio - environment variables
# Everything below is OPTIONAL for device-local browser rendering. With no .env
# file the app still works through WebCodecs; Remotion and hosting license terms
# still apply to the project using it.
# ---------------------------------------------------------------------------

# Turn the server-side renderer (/api/render) on.
# Server rendering executes the uploaded code inside a headless Chrome on YOUR
# server, so only enable it for trusted users or behind auth.
# Values: "1" to enable, anything else / unset = disabled.
ENABLE_SERVER_RENDER=0

# Shared secret sent as x-render-key. Required for every Node or Vercel server
# renderer. The local CLI does not need this key.
RENDER_ACCESS_KEY=

# Server-only NVIDIA NIM key used by the Chat -> Remotion generator. Generate
# the actual secret on build.nvidia.com; NVIDIA keys normally begin with nvapi-.
# Never prefix this variable with NEXT_PUBLIC_.
NVIDIA_API_KEY=

# Optional protection for /api/ai/generate on a deployed app. When unset, the
# route reuses RENDER_ACCESS_KEY if present. Leave both empty only for local use.
AI_ACCESS_KEY=

# Hard safety caps for Node and Vercel Sandbox renders.
MAX_RENDER_FRAMES=1800
MAX_RENDER_PIXELS=8294400

# Chromium OpenGL backend used by the Node renderer. ANGLE is required for
# ThreeCanvas and has a software fallback when no physical GPU is available.
REMOTION_GL=angle

# Concurrency for Node/Vercel rendering. "auto" lets Remotion choose a
# memory-safe worker count; set a number only after measuring the host.
REMOTION_CONCURRENCY=auto

# Browser-render licensing. The default app value is "free-license", suitable
# only when you qualify under https://remotion.dev/license. Otherwise replace
# it with the license key purchased from Remotion.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=free-license

# Required for Vercel Sandbox rendering. Connect a Blob store in the Vercel
# dashboard; Vercel injects this token. It stays optional on a normal Node host.
BLOB_READ_WRITE_TOKEN=

# Optional Vercel Sandbox sizing. Check the limits and cost for your plan.
VERCEL_SANDBOX_VCPUS=4
VERCEL_SANDBOX_TIMEOUT_MS=2700000
