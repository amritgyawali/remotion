# ---------------------------------------------------------------------------
# Remotion Video Studio - environment variables
# Everything below is OPTIONAL. With no .env file at all the app still works:
# it renders 100% free in the visitor's browser (WebCodecs), which costs you $0.
# ---------------------------------------------------------------------------

# Turn the server-side renderer (/api/render) on.
# Server rendering executes the uploaded code inside a headless Chrome on YOUR
# server, so only enable it for trusted users or behind auth.
# Values: "1" to enable, anything else / unset = disabled.
ENABLE_SERVER_RENDER=0

# Optional shared secret. When set, the studio asks for it before server rendering
# and sends it as the x-render-key header.
RENDER_ACCESS_KEY=

# Hard safety caps for server renders (protects your Vercel usage).
MAX_RENDER_FRAMES=1800
MAX_RENDER_PIXELS=8294400

# Chromium OpenGL backend used by the renderer.
# serverless / no GPU -> swangle   |   local machine with GPU -> angle
REMOTION_GL=swangle

# Concurrency for the server renderer. "max" uses every available core.
REMOTION_CONCURRENCY=max

# Browser-render licensing. The default app value is "free-license", suitable
# only when you qualify under https://remotion.dev/license. Otherwise replace
# it with the license key purchased from Remotion.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=free-license

# Optional: deliver finished renders through Vercel Blob instead of streaming
# them back inline. Recommended for videos larger than ~50 MB.
# 1. npm i @vercel/blob
# 2. create a Blob store in the Vercel dashboard (free tier is fine)
BLOB_READ_WRITE_TOKEN=
